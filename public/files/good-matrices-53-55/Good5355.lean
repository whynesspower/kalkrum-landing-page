-- Lean 4 (core only) check of the order-53 and order-55 good quadruples.
-- Sequences are first rows over Z_n (index 0..n-1).
def paf (x : List Int) (n s : Nat) : Int :=
  (List.range n).foldl (fun acc i => acc + x.getD i 0 * x.getD ((i + s) % n) 0) 0
def isSkew (x : List Int) (n : Nat) : Bool :=
  x.getD 0 0 == 1 && (List.range n).all (fun i => i == 0 || x.getD ((n - i) % n) 0 == - x.getD i 0)
def isSym (x : List Int) (n : Nat) : Bool :=
  (List.range n).all (fun i => x.getD ((n - i) % n) 0 == x.getD i 0)
def pm1 (x : List Int) (n : Nat) : Bool := x.length == n && x.all (fun v => v == 1 || v == -1)
def good (n : Nat) (a b c d : List Int) : Bool :=
  pm1 a n && pm1 b n && pm1 c n && pm1 d n && isSkew a n && isSym b n && isSym c n && isSym d n &&
  (paf a n 0 + paf b n 0 + paf c n 0 + paf d n 0 == 4 * n) &&
  (List.range (n - 1)).all (fun t => paf a n (t+1) + paf b n (t+1) + paf c n (t+1) + paf d n (t+1) == 0)

